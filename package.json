{
  "name": "@vidit19sharma/opencode-cursor-auth",
  "version": "0.3.4",
  "description": "OpenCode plugin that uses your Cursor subscription via the official @cursor/sdk — no proxy server, no separate login.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "opencode-cursor-auth": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "installation.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "author": "Vidit Sharma <vidit19sharma@gmail.com> (https://github.com/vidit19sharma)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vidit19sharma/opencode-cursor-auth.git"
  },
  "bugs": {
    "url": "https://github.com/vidit19sharma/opencode-cursor-auth/issues"
  },
  "homepage": "https://github.com/vidit19sharma/opencode-cursor-auth#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "cursor",
    "cursor-sdk",
    "ai",
    "llm",
    "auth"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "test": "bun spike/e2e-bridge.ts",
    "spike": "bun spike/validate-sdk.ts",
    "smoke": "bash scripts/fresh-home-smoke.sh",
    "prepublishOnly": "npm run build",
    "test:cli": "npm run build && bash spike/cli-setup.test.sh",
    "test:plugin": "bun test spike/plugin.test.ts"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.36"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "latest",
    "@types/node": "^26.6.5",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT"
}
